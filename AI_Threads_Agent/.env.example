# ── Google Gemini（免費）──────────────────────────────────────
# 從 https://aistudio.google.com/app/apikey 申請，完全免費
GEMINI_API_KEY=

# ── Threads API（免費）───────────────────────────────────────
# 申請步驟見 README
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ── Imgur（圖片中繼站，免費）────────────────────────────────
# 從 https://api.imgur.com/oauth2/addclient 申請 Client ID
IMGUR_CLIENT_ID=

# ── 字型（選填）──────────────────────────────────────────────
# 如果圖片中文顯示有問題，手動指定字型路徑
# FONT_PATH=C:/Windows/Fonts/msjh.ttc
